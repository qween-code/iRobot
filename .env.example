# LastWarAutoBot Pro - Environment Variables
# Copy this file to .env and customize

# ==========================================
# DATABASE
# ==========================================
POSTGRES_DB=lastwar_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=changeme123_secure_password
POSTGRES_PORT=5432

# ==========================================
# REDIS
# ==========================================
REDIS_PASSWORD=changeme123_redis_password
REDIS_PORT=6379

# ==========================================
# BOT CONFIGURATION
# ==========================================
BOT_CONFIG=configs/default.yaml
LOG_LEVEL=INFO
DEBUG_MODE=false

# ==========================================
# ADB / EMULATOR
# ==========================================
ADB_HOST=127.0.0.1
ADB_PORT=5555
EMULATOR_TYPE=ldplayer  # ldplayer | noxplayer | bluestacks

# ==========================================
# ANTI-BAN
# ==========================================
ENABLE_RANDOMIZATION=true
SESSION_DURATION_MIN=2
SESSION_DURATION_MAX=4
BREAK_DURATION_MIN=30
BREAK_DURATION_MAX=120

# ==========================================
# NOTIFICATIONS
# ==========================================
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK=

# ==========================================
# WEB DASHBOARD
# ==========================================
DASHBOARD_PORT=5000
FLASK_ENV=production
SECRET_KEY=changeme_your_secret_key_here_min_32_chars

# ==========================================
# MONITORING
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# ==========================================
# SECURITY
# ==========================================
# JWT Secret (32+ characters)
JWT_SECRET=changeme_jwt_secret_key_min_32_characters

# Encryption Key (32 bytes, base64 encoded)
# Generate with: python -c "import os; import base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ==========================================
# PROXY (Optional)
# ==========================================
USE_PROXY=false
PROXY_POOL_FILE=configs/proxies.txt
PROXY_ROTATION=true

# ==========================================
# ADVANCED
# ==========================================
# Max concurrent bot instances
MAX_INSTANCES=5

# Resource limits
MAX_CPU_PERCENT=80
MAX_RAM_MB=8192

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=5

# Screenshot settings
SCREENSHOT_FORMAT=png
SCREENSHOT_QUALITY=85
